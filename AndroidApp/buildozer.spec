[app]

# (str) Title of your application
title = Mcutie Chat

# (str) Package name
package.name = mcutiechat

# (str) Package domain (needed for android/ios packaging)
package.domain = org.seumas

# (str) Source code where the main.py live
source.dir = .

# (str) Main script filename
source.main = main.py

# (list) Source files to include (let empty to include all the files)
source.include_exts = py,png,jpg,kv,atlas,json

# (list) Directories to exclude from the APK. rooms/ holds saved rooms (broker passwords and
# room keys) written when the app runs from this folder: never package it.
source.exclude_dirs = tools, bin, p4a-recipes, rooms

# (str) Icons and presplash, generated by assets/icon/make_icons.py (re-run it to change them)
icon.filename = %(source.dir)s/icon/icon.png
icon.adaptive_foreground.filename = %(source.dir)s/icon/icon_fg.png
icon.adaptive_background.filename = %(source.dir)s/icon/icon_bg.png
presplash.filename = %(source.dir)s/icon/presplash.jpg
android.presplash_color = #241647

# (str) Application versioning (method 1)
version = 1.1.0

# (list) Application requirements
# comma separated e.g. requirements = sqlite3,kivy
# charset_normalizer (pulled in by kivy -> requests) is listed explicitly, with an underscore,
# so p4a's resolver doesn't add its Android binary wheel (which p4a then installs with the
# host pip, which rejects it). Build with PIP_NO_BINARY=charset-normalizer so the host pip
# builds it as pure Python instead of bundling its x86_64 wheel.
# paho_mqtt uses the underscore spelling for the same reason: with a hyphen, p4a's resolver
# ignores the pin and adds the latest paho-mqtt wheel, which conflicts with it.
requirements = python3,kivy==2.3.1,paho_mqtt==2.1.0,cryptography,qrcode,pillow,certifi,charset_normalizer

# (list) Supported orientations
# Valid options are: landscape, portrait, portrait-reversed or landscape-reversed
orientation = portrait

#
# Android specific
#

# (bool) Indicate if the application should be fullscreen or not
fullscreen = 0

# (list) Permissions
# USE_BIOMETRIC: the saved-rooms unlock prompt (granted at install, no runtime prompt)
android.permissions = INTERNET, ACCESS_NETWORK_STATE, CAMERA, USE_BIOMETRIC

# (list) The Android archs to build for, choices: armeabi-v7a, arm64-v8a, x86, x86_64
android.archs = arm64-v8a

# (int) Minimum API: 30 (Android 11). Saved rooms need a per-use Keystore key that accepts
# a strong biometric or the screen-lock PIN with a BiometricPrompt CryptoObject (API 30+).
android.minapi = 30
# (int) NDK API for the native recipes: kept at 24 (it would follow minapi) so the tested native
# builds (Python, cryptography's Rust extension) don't change; they run on any newer Android.
android.ndk_api = 24
# p4a refuses minsdk != the dist's NDK API unless told; 30 > 24 is the safe direction.
p4a.extra_args = --allow-minsdk-ndkapi-mismatch

# (str) Release build format: apk for direct download (buildozer's default is aab, for Play Store)
android.release_artifact = apk

# (bool) enables Android auto backup feature (Android API >=23)
# Off: saved rooms hold room keys and MQTT passwords in plaintext
android.allow_backup = False

# (str) Local p4a recipe overrides (cryptography: link the Rust extension against libpython)
p4a.local_recipes = ./p4a-recipes

# (str) Java sources: the BiometricPrompt callback for android_auth.py (pyjnius can't subclass it)
android.add_src = src

# (list) Gradle dependencies: ZXing QR scanner (Java/AAR, no native recipe), used by android_qr.py.
# zxing-android-embedded doesn't ship AndroidX; its CaptureActivity needs androidx.core at runtime
# (ContextCompat/ActivityCompat). 1.9.0 is the newest line that builds with compileSdk 33.
android.gradle_dependencies = com.journeyapps:zxing-android-embedded:4.3.0, androidx.core:core:1.9.0

# (bool) AndroidX, required by zxing-android-embedded 4.x
android.enable_androidx = True

[buildozer]

# (int) Log level (0 = error only, 1 = info, 2 = debug (with command output))
log_level = 2

# (int) Display warning if buildozer is run as root (0 = False, 1 = True)
warn_on_root = 1
